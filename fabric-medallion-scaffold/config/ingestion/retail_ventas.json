      "fecha_hora"
    ],
    "decimal_columns": [
      "precio_unitario",
      "descuento_importe",
      "importe_linea"
    ],
    "id_normalize_columns": [
      "customer_id",
      "ticket_id",
      "product_id"
    ],
    "dedup_order_by": [
      "ultima_actualizacion",
      "_ingestion_timestamp"
    ]
  }
}