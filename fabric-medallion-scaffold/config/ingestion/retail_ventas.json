{
  "source_system": "pos",
  "dataset_name": "ventas",
  "landing_path": "Files/landing/retail/ventas/",
  "source_file": "data/retail_omnicanal/ventas_pos.csv",
  "target_lakehouse": "LH_Bronze",
  "target_schema": "pos",
  "target_table": "ventas",
  "business_key": [
    "ticket_line_id"
  ],
  "file_format": "csv",
  "csv_options": {
    "header": true,
    "delimiter": ",",
    "encoding": "utf-8"
