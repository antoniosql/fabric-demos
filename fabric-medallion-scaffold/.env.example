# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.
# La autenticacion es INTERACTIVA (se abre el navegador); no se usan secretos aqui.

# Tenant de Fabric/Entra (GUID). Opcional si tu cuenta pertenece a un unico tenant.
FABRIC_TENANT_ID=

# Id de la capacidad Fabric (SKU F) a la que se asignaran los workspaces.
# Formato: GUID de la capacidad (Fabric REST) — no el resource id de Azure.
FABRIC_CAPACITY_ID= 

# Nombre del dominio (por defecto se toma de config/workspaces.json).
# FABRIC_DOMAIN=Retail
