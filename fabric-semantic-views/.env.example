# Copia este fichero a `.env` y completa los valores. `.env` está en .gitignore: no lo subas.
# La autenticación es interactiva (az login o navegador): aquí no hay secretos.

# Tenant de Entra (GUID). Opcional si tu cuenta pertenece a un único tenant.
FABRIC_TENANT_ID=

# Capacidad Fabric de pago (F2 o superior) donde se crea el workspace. El Data Agent no funciona en trial.
# Indica UNA de las dos: el GUID de la capacidad (Fabric > Admin portal > Capacity settings) o su nombre.
FABRIC_CAPACITY_ID=
FABRIC_CAPACITY_NAME=

# Workspace de la demo. Si ya existe, se reutiliza; si no, se crea.
# Debe ser un workspace APARTE: las vistas semánticas (preview) no se publican en workspaces conectados a Git
# ni a pipelines de despliegue.
FABRIC_WORKSPACE_NAME=ws_frasohome_semantic_views

# Lakehouse donde se cargan los CSV y se construyen las tablas.
FABRIC_LAKEHOUSE_NAME=lh_frasohome

# true crea el lakehouse con esquemas (dbo.<tabla>), que es lo que asume `schema.yaml`.
# Si lo pones a false, quita `dbo.` de los `source` de schema.yaml.
FABRIC_LAKEHOUSE_SCHEMAS=true

# cli (usa `az login`, recomendado) | browser (abre el navegador) | devicecode
FABRIC_AUTH_MODE=cli
